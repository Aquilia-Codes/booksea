# Copy to .env and fill in. Never commit the real .env.

# Render Postgres connection string (Dashboard -> your database -> Connect)
DATABASE_URL="postgresql://user:password@host:5432/booksea?sslmode=require"

# Same OAuth client(s) the Flutter app's google_sign_in already uses -
# pulled from booksea_app/android/app/google-services.json. Space-separated
# if there's more than one (android + ios + web client ids all need to be
# accepted as valid audiences).
GOOGLE_OAUTH_CLIENT_IDS="683257674665-6rho5dria0i1e0oekm3fgjkbjle7ab9a.apps.googleusercontent.com 683257674665-vl4nol9g3quldieouhhmu20ndf87fa57.apps.googleusercontent.com"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
CORS_ORIGIN="*"
