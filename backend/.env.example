# Copy to .env and fill in. Never commit the real .env.

# Render Postgres connection string (Dashboard -> your database -> Connect)
DATABASE_URL="postgresql://user:password@host:5432/booksea?sslmode=require"

# The WEB OAuth client id from Google Cloud Console (not the Android one) -
# this is what the Flutter app passes as serverClientId (see
# lib/providers/auth_provider.dart's _googleServerClientId), so it's what
# Google addresses the idToken to, and what this list needs to trust.
# Space-separated if you ever add more than one (e.g. a separate iOS/web
# client later).
GOOGLE_OAUTH_CLIENT_IDS="865744272369-atobvfr5mo0s5prs63v99rg5872ehgp2.apps.googleusercontent.com"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=4000
CORS_ORIGIN="*"
